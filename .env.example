# Copy to .env in repo root for local dev (frontend + backend read via tooling).
# On Render, set these on the Web Service environment.

# Supabase project URL (Settings → API)
SUPABASE_URL=
# Server only — never commit or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (Vite) — same project, anon key only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Express API origin when the SPA is hosted separately (no trailing slash).
# VITE_API_BASE_URL=https://your-api.onrender.com

# Local dev only: override Vite’s /api proxy target (default http://127.0.0.1:3001).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:3001

# SPA origin for CORS (same pattern as BowlWise). Defaults to local Vite if unset.
# Split deploy: set to your static site URL, e.g. https://your-site.onrender.com
# Optional: comma-separated for www + apex, e.g. https://a.com,https://www.a.com
# FRONTEND_URL=http://localhost:5173

# Optional: absolute path to a built SPA (index.html) when frontend/dist is not next to backend/dist.
# CLIENT_DIST=

# Home Services embed (public widget). After running Supabase migration 003, copy embed_public_key for Parker Electric.
# VITE_HOME_SERVICES_EMBED_KEY=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

# Anthropic (server only) — required for embed chat replies. Optional: override model ID.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Homi (property data POC). Server-only keys.
# RentCast: self-serve free tier at https://app.rentcast.io/app/api
RENTCAST_API_KEY=
# Attom: enterprise; leave blank — provider stays disabled.
ATTOM_API_KEY=
# RealEstate API: self-serve; leave blank — provider stays disabled.
REALESTATEAPI_KEY=
