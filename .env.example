# Copy to .env in repo root for local dev (frontend + backend read via tooling).
# On Render, set these on the Web Service environment.

# Supabase project URL (Settings → API)
SUPABASE_URL=
# Server only — never commit or expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (Vite) — same project, anon key only
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Comma-separated emails that may use /projects and /api/projects/* (required for access).
# Empty = no project access for anyone (safe with public Supabase sign-up).
ALLOWED_ADMIN_EMAILS=
